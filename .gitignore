# Secrets and personal data — never commit these
config.json
config.json.bak-*
resume.md
resume.txt
interview_index.json
interview_index.json.bak
interview_index.vectors.npy
*.npy.tmp
*.json.tmp
usage_ledger.json
job_description.md

# Python
__pycache__/
*.pyc
ui_settings.json

# Google Drive sync temp dirs
.tmp.driveupload/
.tmp.drivedownload/

# Mock session recordings/transcripts (large + private)
Mock Sessions/

# Course material lives in the Obsidian vault (already indexed from vault_path). A copy dropped
# here is NOT indexed and is not this repo's content.
System Design School/

# Locally generated TLS material for the phone mirror (--https). Private keys — never commit.
ia-ca.crt
ia-ca.key
ia-server.crt
ia-server.key
ia-server.hosts
ia_token

# Profile store: positions, JDs and imported CVs. Personal data -- never commit.
profiles.json
resumes/

# Demo vault index (generated by config.demo.json, regenerable)
demo-index.json
demo-index.vectors.npy

# Provider API keys entered in the UI with "remember" ticked. Plaintext secrets -- never commit.
api_keys.json

# Partial index from an interrupted --build-index (regenerable, deleted on success)
*.partial.json

# Personal test scripts. They run against the owner's own notes and CV and spend API credit, so they stay on this machine and are never published.
qa-local/

# The private list of personal terms the public export must never contain (tools/export_public.py).
public-denylist.txt
